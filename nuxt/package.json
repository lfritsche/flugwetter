{
  "name": "flugwetter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "nuxt build && XDG_CONFIG_HOME=$HOME/.config/wrangler-flugwetter wrangler --cwd .output deploy",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "e2e": "playwright test"
  },
  "dependencies": {
    "nuxt": "4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12",
    "wrangler": "4.148.0"
  }
}
